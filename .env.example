# Copy to `.env` (next to compose.yaml) and edit. Compose reads that file
# automatically; everything here has a working default, so an empty or absent
# .env gives the development setup.
#
#   cp .env.example .env

# --------------------------------------------------------------------------
# Running on a server
# --------------------------------------------------------------------------

# Hostnames Vite's *development* server will answer to, comma-separated.
# Without this it refuses anything but localhost and bare IPs with
# "Blocked request. This host (...) is not allowed." A leading dot covers a
# domain and its subdomains: .ime.usp.br allows kamel.ime.usp.br.
#
# Only the `dpasp` and `mock` profiles need it. The `dpasp-prod` profile runs
# the built app, which has no host check.
#DPASP_ALLOWED_HOSTS=kamel.ime.usp.br

# The URL users type, for the `dpasp-prod` profile. Without it the server
# assumes https:// and takes the host from the request, which breaks
# generated links and OAuth callbacks on a plain-HTTP deployment.
#DPASP_ORIGIN=http://kamel.ime.usp.br:8000

# Behind a reverse proxy that terminates TLS: leave DPASP_ORIGIN empty and set
# these instead, so the app sees the public scheme and host rather than the
# proxy's.
#DPASP_PROTOCOL_HEADER=x-forwarded-proto
#DPASP_HOST_HEADER=x-forwarded-host

# Published port for the frontend. 8000 by default.
#DPASP_PORT=8000

# Restart policy. `no` suits a laptop; `unless-stopped` brings the stack back
# after a reboot, which is what a server wants.
#DPASP_RESTART=unless-stopped

# Largest request body the built frontend accepts, in bytes. An upload is one
# JSON body, so this is the effective upload limit. 32 MB by default; the
# framework's own default would be 512 kB.
#DPASP_BODY_SIZE_LIMIT=33554432

# --------------------------------------------------------------------------
# Limits inside the runner
# --------------------------------------------------------------------------

# Forwarded into every runner container (containerManager.RUNNER_ENV_KEYS).

# Wall-clock ceiling for one run, in seconds.
#DPASP_RUN_TIMEOUT=300

# Heap a program may allocate, in MB, on top of what loading dPASP costs.
# Must fit inside DPASP_RUNNER_MEM below, with room for the ~800 MB that
# loading dPASP itself takes — the manager warns at startup if it does not.
#DPASP_RUN_MEM_MB=1024

# Cap on captured program output, in characters.
#DPASP_MAX_OUTPUT=65536

# --------------------------------------------------------------------------
# Limits on the runner container
# --------------------------------------------------------------------------

# A dPASP program may contain a `#python ... #end.` block, which is arbitrary
# Python running inside the runner container. The container is the security
# boundary; these are what bound it. The manager prints the effective set at
# startup.

# Cores one runner may use, as a hard quota. Fractions are allowed. Thread
# pools inside the container (PyTorch, OpenMP, OpenBLAS) are pinned to this,
# since they would otherwise size themselves from the host's CPU count.
#DPASP_RUNNER_CPUS=1.0

# Memory per runner, swap included (swap is disabled). Covers loading dPASP,
# the program's own heap, and the tmpfs below.
#DPASP_RUNNER_MEM=3g

# Processes and threads per runner. Bounds a fork bomb to its own container.
#DPASP_RUNNER_PIDS=256

# Size of the in-memory /blobs filesystem, in MB — where uploads land. It is
# charged to DPASP_RUNNER_MEM, so keep the two consistent.
#DPASP_RUNNER_TMPFS_MB=256

# 1 (default) mounts the runner's root filesystem read-only, with tmpfs for
# /tmp and /blobs. Set to 0 if something in the image turns out to need to
# write elsewhere.
#DPASP_RUNNER_READONLY=1

# 0 (default) keeps runners on an internal network with no route off the
# host: a program cannot reach the internet, and neither can anything a
# `#python` block starts. Set to 1 to attach the default bridge as well,
# which the MNIST example (it downloads a dataset) and learning.pasp as
# shipped (it reads a CSV over https) both need. Uploading the CSV and
# referring to it by name works either way, and is the better habit.
#DPASP_RUNNER_ALLOW_NETWORK=0

# How long the frontend waits for a run, in milliseconds. Keep it above
# DPASP_RUN_TIMEOUT so the runner's own deadline is the one that fires.
#DPASP_PROXY_TIMEOUT_MS=330000

# --------------------------------------------------------------------------
# Docker
# --------------------------------------------------------------------------

# Where the daemon's socket is, when it is not /var/run/docker.sock — as
# under colima:
#   DOCKER_SOCKET=$(docker context inspect -f '{{.Endpoints.docker.Host}}' | sed 's|^unix://||')
#DOCKER_SOCKET=/var/run/docker.sock

# Exact name of the network runners are attached to. Normally found by
# matching `dpasp-instances`, disambiguated by this stack's Compose labels.
# Set it if `docker network ls | grep dpasp-instances` shows more than one and
# the manager reports it cannot choose — a runner on the wrong network shows
# up as `getaddrinfo ENOTFOUND dpasp-instance-<id>` in the frontend log.
#DPASP_RUNNER_NETWORK=web_dpasp-instances

# Seconds to wait, after a new runner first reports `running`, before checking
# again that it is still up. Covers a container that exits milliseconds into
# startup, which would otherwise be handed out as healthy. Raise it on a slow
# or heavily loaded host.
#DPASP_RUNNER_START_GRACE=0.75

# --------------------------------------------------------------------------
# Sign-in (optional)
# --------------------------------------------------------------------------

# With none of these set, every visitor gets an anonymous session and the
# sign-in link is hidden. See editor/.env.example for what they mean and how
# to register the OAuth apps. The callback URL must match DPASP_ORIGIN.
#AUTH_SECRET=
#GITHUB_ID=
#GITHUB_SECRET=
#GOOGLE_ID=
#GOOGLE_SECRET=

# Copy to `.env` (next to compose.yaml) and edit. Compose reads that file
# automatically; everything here has a working default, so an empty or absent
# .env gives the development setup.
#
#   cp .env.example .env

# --------------------------------------------------------------------------
# Running on a server
# --------------------------------------------------------------------------

# Hostnames Vite's *development* server will answer to, comma-separated.
# Without this it refuses anything but localhost and bare IPs with
# "Blocked request. This host (...) is not allowed." A leading dot covers a
# domain and its subdomains: .ime.usp.br allows kamel.ime.usp.br.
#
# Only the `dpasp` and `mock` profiles need it. The `dpasp-prod` profile runs
# the built app, which has no host check.
#DPASP_ALLOWED_HOSTS=kamel.ime.usp.br

# The URL users type, for the `dpasp-prod` profile. Without it the server
# assumes https:// and takes the host from the request, which breaks
# generated links and OAuth callbacks on a plain-HTTP deployment.
#DPASP_ORIGIN=http://kamel.ime.usp.br:8000

# Behind a reverse proxy that terminates TLS: leave DPASP_ORIGIN empty and set
# these instead, so the app sees the public scheme and host rather than the
# proxy's.
#DPASP_PROTOCOL_HEADER=x-forwarded-proto
#DPASP_HOST_HEADER=x-forwarded-host

# Published port for the frontend. 8000 by default.
#DPASP_PORT=8000

# Restart policy. `no` suits a laptop; `unless-stopped` brings the stack back
# after a reboot, which is what a server wants.
#DPASP_RESTART=unless-stopped

# Largest request body the built frontend accepts, in bytes. An upload is one
# JSON body, so this is the effective upload limit. 32 MB by default; the
# framework's own default would be 512 kB.
#DPASP_BODY_SIZE_LIMIT=33554432

# --------------------------------------------------------------------------
# Runner limits
# --------------------------------------------------------------------------

# Forwarded into every runner container (containerManager.RUNNER_ENV_KEYS).

# Wall-clock ceiling for one run, in seconds.
#DPASP_RUN_TIMEOUT=300

# Heap a program may allocate, in MB, on top of what loading dPASP costs.
#DPASP_RUN_MEM_MB=1024

# Cap on captured program output, in characters.
#DPASP_MAX_OUTPUT=65536

# How long the frontend waits for a run, in milliseconds. Keep it above
# DPASP_RUN_TIMEOUT so the runner's own deadline is the one that fires.
#DPASP_PROXY_TIMEOUT_MS=330000

# --------------------------------------------------------------------------
# Docker
# --------------------------------------------------------------------------

# Where the daemon's socket is, when it is not /var/run/docker.sock — as
# under colima:
#   DOCKER_SOCKET=$(docker context inspect -f '{{.Endpoints.docker.Host}}' | sed 's|^unix://||')
#DOCKER_SOCKET=/var/run/docker.sock

# --------------------------------------------------------------------------
# Sign-in (optional)
# --------------------------------------------------------------------------

# With none of these set, every visitor gets an anonymous session and the
# sign-in link is hidden. See editor/.env.example for what they mean and how
# to register the OAuth apps. The callback URL must match DPASP_ORIGIN.
#AUTH_SECRET=
#GITHUB_ID=
#GITHUB_SECRET=
#GOOGLE_ID=
#GOOGLE_SECRET=

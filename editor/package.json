{
  "name": "my-app",
  "version": "0.0.1",
  "private": true,
  "//": [
    "Every script that reads tsconfig.json runs `svelte-kit sync` first: it",
    "generates .svelte-kit/tsconfig.json, which tsconfig.json extends and",
    "which is not in git. See 'Cannot find base config file' in ../README.md.",
    "",
    "There is no UI component library here on purpose. The eight flowbite",
    "components this used were thin wrappers over Tailwind classes, and they",
    "cost two of this project's bugs and a whole dependency chain in",
    "`npm audit`; `src/lib/ui/` now holds local equivalents. See 'The",
    "framework upgrade' in ../README.md."
  ],
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "svelte-kit sync && vite dev --port 80 --host",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --port 80 --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output human",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output human --watch",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "dependencies": {
    "@auth/sveltekit": "^1.11.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@rich_harris/svelte-split-pane": "^3.0.0",
    "codemirror": "^6.0.2",
    "svelte-codemirror-editor": "^2.1.0",
    "undici": "^8.10.2"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}

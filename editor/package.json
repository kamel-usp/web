    "postcss": "^8.4.29",
    "postcss-load-config": "^4.0.1",
    "svelte": "^4.0.5",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.3.3",
    "tslib": "^2.4.1",
    "typescript": "~5.4.5",
    "vite": "^4.4.2",
    "vitest": "^1.6.1"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "^0.15.0",
    "@auth/sveltekit": "^0.3.7",

# Fail the install when a dependency's `engines.node` is not satisfied, rather
# than printing EBADENGINE and carrying on. This is worth having since the
# framework upgrade moved the floor: `undici` 8 declares `node >= 22.19.0` and
# vitest 5 `^22.12 || ^24 || >=26`, so on an older Node the install would
# otherwise succeed and the *first request to a runner* would be what failed.
engine-strict=true

# `resolution-mode=highest` used to be here. It is a **pnpm** option — npm has
# never had one by that name — so under npm it did nothing except print
#
#     npm warn Unknown project config "resolution-mode".
#
# on every install. Removed rather than renamed: npm resolves to the highest
# version satisfying each range already, which is what it was asking for.

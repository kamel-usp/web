# The playground runs without any of these: with no OAuth credentials every
# visitor gets an anonymous session, keyed by a random cookie, and the sign-in
# link is hidden. Copy this file to `.env` only if you want persistent logins.
#
#   cp editor/.env.example editor/.env
#
# Values are read at run time (`$env/dynamic/private`), so a missing variable
# never breaks the build.

# Required whenever any OAuth provider below is configured.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=
